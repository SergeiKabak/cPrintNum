// PrintNum — нативный GUI на Slint (одна тёмная тема).
//
// Один экран: управление запуском и все настройки видны одновременно
// (отдельной страницы настроек нет).
//
// ВАЖНО про иконки: используется ТОЛЬКО текст. Причины:
//   1. software-рендерер Slint не рисует векторные Path (draw_path — заглушка);
//   2. многие Unicode-символы не находятся в системных шрифтах и рисуются
//      пустым местом (проверено: U+25B6 ▶, U+2699 ⚙, U+2715 ✕, U+23FB ⏻ —
//      не рисуются; U+2014 —, U+00D7 × — рисуются).
// Поэтому управление — кликабельный текст «Запустить» / «Остановить»,
// а в шапке только «—» (свернуть) и «×» (закрыть).

import { CheckBox, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";

// ---- Палитра (одна тёмная тема) ----
global Palette {
    in-out property <color> bg: #111318;
    in-out property <color> panel: #181b22;
    in-out property <color> panel-2: #1f232c;
    in-out property <color> border: #2a2f3a;
    in-out property <color> fg: #e8eaf0;
    in-out property <color> muted: #98a0b3;
    in-out property <color> accent: #3b82f6;
    in-out property <color> accent-hi: #60a5fa;
    in-out property <color> accent-fg: #ffffff;
    in-out property <color> danger: #ef4444;
    in-out property <color> danger-hi: #ff7a7a;
    in-out property <color> success: #22c55e;
    in-out property <color> success-hi: #5ee58c;
    in-out property <color> white: #ffffff;
    in-out property <color> black: #000000;
}

// ============================================================================
// Переиспользуемые компоненты
// ============================================================================

// Разделитель секций.
// Раньше этот Rectangle дублировался пять раз подряд.
component Divider inherits Rectangle {
    height: 1px;
    background: Palette.border;
}

// Подпись поля формы («Принтер», «Этикетка (mm)»).
component FieldLabel inherits Text {
    color: Palette.muted;
    font-size: 12px;
}

// Мелкая пояснительная подпись по центру.
component HintLabel inherits Text {
    color: Palette.muted;
    font-size: 10px;
    horizontal-alignment: center;
}

// Заголовок секции.
component SectionTitle inherits Text {
    color: Palette.fg;
    font-size: 12px;
    font-weight: 600;
    horizontal-alignment: center;
}

// Кнопка с текстом (без иконок — см. комментарий в шапке файла).
//
// Высоту НЕ задаём: в HorizontalLayout её определяет layout. Явная высота
// у прямого потомка layout раньше ломала геометрию (см. историю TitleButton).
component TextButton inherits Rectangle {
    in property <string> label;
    in property <color> base: Palette.accent;
    in property <color> hover: Palette.accent-hi;
    in property <color> text-color: Palette.accent-fg;
    in property <length> font-size: 13px;
    in property <int> font-weight: 600;
    in property <bool> bold: false;

    callback clicked();

    border-radius: 6px;
    background: touch.pressed
        ? Palette.panel-2
        : (touch.has-hover ? hover : base);

    Text {
        width: 100%;
        height: 100%;
        text: root.label;
        color: root.text-color;
        font-size: root.font-size;
        font-weight: root.bold ? 700 : root.font-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// Квадратная кнопка-шаг «−»/«+» для поля «Начиная с номера».
component StepperButton inherits Rectangle {
    in property <string> label;
    callback clicked();

    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: touch.pressed ? Palette.border : Palette.panel-2;
    border-width: 1px;
    border-color: Palette.border;

    Text {
        width: 100%;
        height: 100%;
        text: root.label;
        color: Palette.fg;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// Чекбокс с белым текстом.
component WhiteCheckBox {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled(bool);

    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        // Двусторонняя привязка (<=>, а не :) — иначе присваивание
        // в checked извне конфликтует с привязкой и затирается.
        cb := CheckBox {
            checked <=> root.checked;
            toggled => { root.toggled(self.checked); }
        }
        Text {
            text: root.text;
            color: Palette.white;
            vertical-alignment: center;
            // Клик по подписи переключает чекбокс.
            // TouchArea лежит только на тексте, чтобы не перекрывать сам
            // CheckBox: иначе клик по квадратику вызывал бы оба обработчика.
            TouchArea {
                clicked => {
                    root.checked = !root.checked;
                    root.toggled(root.checked);
                }
                mouse-cursor: pointer;
            }
        }
    }
}

// Превью одной этикетки (белый прямоугольник с номером).
//
// Используется дважды: для одиночной этикетки и для правой этикетки
// в гибридном режиме. Различаются только подписи и начертание номера.
component LabelPreview inherits VerticalLayout {
    // Ширину задаём самому компоненту: внутри HorizontalLayout он иначе
    // растягивается, и width: 76px у вложенного Rectangle не ограничивает
    // внешнюю геометрию — этикетка «расползается» на всю доступную ширину.
    width: 76px;
    // Подпись под/над этикеткой ("Этикетки 1 – 499").
    in property <string> caption: "";
    in property <bool> show-caption: false;
    // Текст в левом верхнем углу (номер колонтитула).
    in property <string> corner-text: "";
    in property <bool> show-corner: false;
    in property <bool> corner-right: false;
    // Начертание основного номера.
    in property <bool> main-bold: false;
    in property <bool> id-num: false;
    in property <bool> end-line: false;

    spacing: 4px;

    if root.show-caption : Text {
        text: root.caption;
        color: Palette.muted;
        font-size: 10px;
        horizontal-alignment: center;
    }

    Rectangle {
        width: 76px;
        height: 48px;
        border-radius: 8px;
        background: Palette.white;
        border-width: 1px;
        border-color: Palette.border;

        VerticalLayout {
            padding: 4px;

            if root.show-corner : Text {
                text: root.corner-text;
                color: Palette.black;
                font-family: "Arial";
                font-size: 8px;
                horizontal-alignment: root.corner-right ? right : left;
            }

            Rectangle {
                vertical-stretch: 1;
                background: transparent;

                Text {
                    text: !root.end-line ? "123." : "123";
                    color: Palette.black;
                    font-family: "Arial";
                    font-size: 26px;
                    font-weight: root.main-bold ? 700 : 400;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                // Имитация подчёркивания (векторные Path не поддерживаются).
                if root.end-line : Rectangle {
                    x: (parent.width - 44px) / 2;
                    y: parent.height - 8px;
                    width: 44px;
                    height: 2px;
                    background: Palette.black;
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "PrintNum — Печать ячеек";
    width: 460px;
    height: 440px;
    background: Palette.bg;
    default-font-family: "Segoe UI";
    always-on-top: true;

    in-out property <bool> server-online: true;
    in-out property <bool> printer-online: false;
    in-out property <bool> dry-run: false;
    in-out property <string> version: "3.1.0";
    in-out property <bool> running: true;

    // Настройки
    in-out property <string> printer: "";
    in-out property <string> paper: "30*20";
    in-out property <bool> id-num: false;
    in-out property <bool> end-line: false;
    in-out property <bool> hybrid: false;
    in-out property <int> expand: 500;

    // Индексы для ComboBox (вычисляются в Rust).
    in-out property <int> printer-index: 0;
    in-out property <int> paper-index: 0;

    // Ручная печать: номер ячейки, введённый в самом окне.
    // Значение фильтруется в Rust (колбэк manual-text-edited).
    in-out property <string> manual-text: "";

    in property <[string]> list-printers: [];
    in property <[string]> list-papers: ["30*20", "40*30", "43*25", "50*70", "58*40", "60*40", "75*120", "100*150"];

    // Колбэки в Rust
    callback set-running(bool);
    callback set-printer(string);
    callback set-paper(string);
    callback set-id-num(bool);
    callback set-end-line(bool);
    callback set-hybrid(bool);
    callback set-expand(int);
    // Ручная печать.
    callback manual-text-edited(string);
    callback print-text(string);

    // ===== Загрузочный экран =====
    if !server-online : Rectangle {
        background: Palette.bg;
        VerticalLayout {
            alignment: center;
            spacing: 14px;
            Text {
                text: "Приложение запускается...";
                color: Palette.muted;
                font-size: 13px;
                horizontal-alignment: center;
            }
        }
    }

    // ===== Основной экран (запуск + настройки вместе) =====
    //
    // Собственной шапки нет: окно использует системную рамку Windows,
    // в которой уже есть кнопки «свернуть» и «закрыть».
    if server-online : VerticalLayout {
        // ---- Контент: управление + настройки ----
        Rectangle {
            vertical-stretch: 1;
            background: Palette.bg;

            ScrollView {
                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;

                    // ===== Управление: кликабельный текст =====
                    //
                    // Контейнер во всю ширину, текст центрируется явно по X.
                    // Явные width/height у прямого потомка layout ломали бы
                    // центрирование, поэтому элемент лежит в контейнере.
                    Rectangle {
                        height: 34px;
                        background: transparent;

                        Text {
                            x: (parent.width - 260px) / 2;
                            y: 0;
                            width: 240px;
                            height: 34px;
                            text: root.running ? "Остановить" : "Запустить";
                            color: run-touch.has-hover
                                ? (root.running ? Palette.danger-hi : Palette.success-hi)
                                : (root.running ? Palette.danger : Palette.success);
                            font-size: 20px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        // Подчёркивание при наведении — визуальный отклик.
                        Rectangle {
                            x: (parent.width - 130px) / 2;
                            y: 29px;
                            width: 130px;
                            height: 2px;
                            background: run-touch.has-hover
                                ? (root.running ? Palette.danger : Palette.success)
                                : transparent;
                        }
                        run-touch := TouchArea {
                            clicked => { root.set-running(!root.running); }
                            mouse-cursor: pointer;
                        }
                    }

                    Text {
                        text: root.running ? "Приложение запущено" : "Приложение остановлено";
                        color: Palette.muted;
                        font-size: 11px;
                        horizontal-alignment: center;
                    }

                    Divider { }

                    // Принтер + Этикетка
                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            FieldLabel { text: "Принтер"; }
                            ComboBox {
                                model: list-printers;
                                current-index: root.printer-index;
                                selected(value) => { root.set-printer(value); }
                            }
                        }
                        VerticalLayout {
                            FieldLabel { text: "Этикетка (mm)"; }
                            ComboBox {
                                model: list-papers;
                                current-index: root.paper-index;
                                selected(value) => { root.set-paper(value); }
                            }
                        }
                    }

                    Divider { }

                    // ===== Ручная печать =====
                    SectionTitle { text: "Ручная печать"; }

                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            horizontal-stretch: 1;
                            // input-type: number здесь НЕ подходит: он пропускает
                            // только ASCII-цифры и отклоняет дефис, а номер
                            // ячейки имеет вид "500-47". Поэтому поле обычное,
                            // а фильтрация ввода делается в Rust
                            // (колбэк manual-text-edited).
                            placeholder-text: "Номер ячейки, например 500-47";
                            text <=> manual-text;
                            edited(val) => { root.manual-text-edited(val); }
                            accepted(val) => { root.print-text(val); }
                        }
                        TextButton {
                            width: 96px;
                            label: "Печать";
                            clicked => { root.print-text(root.manual-text); }
                        }
                    }

                    HintLabel { text: "Только цифры и дефис. Enter — тоже печать."; }

                    Divider { }

                    // ===== Оформление этикетки =====
                    SectionTitle { text: "Оформление этикетки"; }

                    HorizontalLayout {
                        spacing: 8px;

                        // ---- Настройки ----
                        VerticalLayout {
                            spacing: 4px;
                            WhiteCheckBox {
                                text: "Показывать ID";
                                checked <=> root.id-num;
                                toggled => { root.set-id-num(self.checked); }
                            }
                            WhiteCheckBox {
                                text: "Подчёркивание";
                                checked <=> root.end-line;
                                toggled => { root.set-end-line(self.checked); }
                            }
                            WhiteCheckBox {
                                text: "Гибридный формат";
                                checked <=> root.hybrid;
                                toggled => { root.set-hybrid(self.checked); }
                            }

                            // Порог гибридного режима — виден только когда он включён.
                            if root.hybrid : HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Начиная с номера";
                                    color: Palette.muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                StepperButton {
                                    label: "−";
                                    clicked => { root.set-expand(Math.max(1, root.expand - 1)); }
                                }
                                LineEdit {
                                    width: 56px;
                                    text: root.expand;
                                    input-type: number;
                                    edited => {
                                        root.set-expand(Math.max(1, floor(self.text.to-float())));
                                    }
                                }
                                StepperButton {
                                    label: "+";
                                    clicked => { root.set-expand(root.expand + 1); }
                                }
                            }
                        }

                        // ---- Превью ----
                        HorizontalLayout {
                            spacing: 4px;

                            LabelPreview {
                                show-caption: root.hybrid;
                                caption: "Этикетки 1 – " + (root.expand - 1);
                                show-corner: root.id-num;
                                corner-text: "−47";
                                corner-right: true;
                                main-bold: false;
                                end-line: root.end-line;
                            }

                            if root.hybrid : LabelPreview {
                                show-caption: true;
                                caption: "Этикетки от " + root.expand;
                                show-corner: true;
                                corner-text: root.expand + "−";
                                corner-right: false;
                                main-bold: true;
                                end-line: root.end-line;
                            }
                        }
                    }

                    Divider { }
                }
            }
        }

        // ---- Footer ----
        Rectangle {
            height: 32px;
            background: Palette.panel;
            border-width: 1px;
            border-color: Palette.border;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;

                Text {
                    text: "v" + root.version;
                    color: Palette.muted;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                if root.dry-run : Text {
                    text: "РЕЖИМ ЭМУЛЯЦИИ";
                    color: Palette.accent;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                if !root.printer-online && !root.dry-run : Text {
                    text: "Принтер НЕДОСТУПЕН";
                    color: Palette.danger;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
    }
}
