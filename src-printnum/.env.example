# Пример настроек окружения PrintNum.
#
# Скопируйте этот файл в `.env` и при необходимости измените значения:
#
#   cp .env.example .env
#
# Файл `.env` ищется в текущей рабочей директории и рядом с исполняемым файлом.
# Переменная окружения имеет приоритет над `.env`.

# Порт HTTP-сервера, который слушает приложение.
# ВАЖНО: тот же порт должен быть указан в extension/.env (VITE_PRINTNUM_PORT),
# иначе браузерное расширение не найдёт приложение.
PRINTNUM_PORT=5000

# Режим эмуляции печати (dry-run). Раскомментируйте для проверки без принтера.
# 1, true, yes, on — включено.
# PRINTNUM_DRY_RUN=1
