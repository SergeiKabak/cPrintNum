# Пример окружения расширения PrintNum.
#
#   cp .env.example .env
#
# Порт службы печати: по умолчанию 5000 (зашит в C-службе). Менять нужно
# только если службу пересобрали с другим портом — тогда тот же порт задаётся
# здесь. Значение подставляется Vite на этапе сборки (`npm run dev` /
# `npm run build`), после изменения нужна пересборка расширения.

VITE_PRINTNUM_PORT=5000
