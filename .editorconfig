# Единый стиль для всех редакторов (VS Code, Cursor, JetBrains, vim…).
# Prettier в extension/ задаёт более точные правила для TS/TSX — здесь база.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# C-служба: 4 пробела, как в printnum-win7.c
[*.{c,h}]
indent_size = 4
indent_style = space

# Markdown: хвостовые пробелы = перенос строки, не трогаем
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[{*.yml,*.yaml}]
indent_size = 2
