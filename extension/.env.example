# Пример настроек окружения расширения PrintNum.
#
# Скопируйте в `.env` и задайте тот же порт, что и в приложении
# (PRINTNUM_PORT в src-printnum/.env или в его переменной окружения):
#
#   cp .env.example .env
#
# Значение подставляется Vite на этапе сборки (`npm run dev` / `npm run build`),
# поэтому после изменения требуется пересобрать расширение.

VITE_PRINTNUM_PORT=5000
